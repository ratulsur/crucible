# ── LLM (the agents' reasoning) ─────────────────────────────────────────
# Set at least one. Anthropic is used by default when present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER=auto            # auto | anthropic | openai
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# LLM_TEMPERATURE=0.6

# ── Audio (speech in/out) ───────────────────────────────────────────────
# Requires OPENAI_API_KEY. Without it the web client falls back to the
# browser's built-in speech engine.
# AUDIO_PROVIDER=openai          # openai | none
# STT_MODEL=gpt-4o-transcribe
# TTS_MODEL=gpt-4o-mini-tts

# ── App ─────────────────────────────────────────────────────────────────
# PORT=8000                      # Railway sets this automatically
# CRUCIBLE_DB=crucible.db
# CRUCIBLE_ACCESS_TOKEN=         # set to gate the API behind a shared secret
SECRET_KEY=                      # required for JWT auth — set to a long random string
